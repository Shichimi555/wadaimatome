---
// src/pages/articles/[slug].astro
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import AdMax from '../../components/AdMax.astro';
import { AD_SLOTS, MOBILE_MEDIA } from '../../lib/ads';
import { articlePath, tagPath } from '../../lib/urls';
import { breadcrumbTag, countTags, splitTags } from '../../lib/tags';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.draft !== true);
  const tagCounts = countTags(articles);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, tagCounts },
  }));
}

const { article, tagCounts } = Astro.props;
const { Content } = await render(article);

// The mid-article slot belongs before the second heading, but render() hands
// back a component rather than markup. The entry carries the same HTML the
// component emits — byte for byte — so the split works on that, and falls back
// to one undivided body if a future Astro stops populating it.
const body = article.rendered?.html;
const secondHeading = body ? body.indexOf('<h2', body.indexOf('<h2') + 1) : -1;
const bodyBefore = secondHeading > 0 ? body!.slice(0, secondHeading) : null;
const bodyAfter = secondHeading > 0 ? body!.slice(secondHeading) : null;
const ogImage = `/og/${article.id}.png`;
const { linked, plain } = splitTags(article.data.tags, tagCounts);
const crumb = breadcrumbTag(article.data.tags, tagCounts);

const site = Astro.site!.href.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site).href;
const published = article.data.pubDate.toISOString();

const schema = [
  {
    '@type': 'NewsArticle',
    '@id': `${url}#article`,
    mainEntityOfPage: url,
    headline: article.data.title,
    description: article.data.description,
    image: new URL(ogImage, Astro.site).href,
    datePublished: published,
    dateModified: published,
    inLanguage: 'ja',
    keywords: article.data.tags.join(', '),
    isAccessibleForFree: true,
    author: { '@type': 'Organization', name: '話題まとめ', url: `${site}/` },
    publisher: { '@type': 'Organization', name: '話題まとめ', url: `${site}/` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${site}/` },
      ...(crumb
        ? [{ '@type': 'ListItem', position: 2, name: crumb, item: `${site}${tagPath(crumb)}` }]
        : []),
      { '@type': 'ListItem', position: crumb ? 3 : 2, name: article.data.title },
    ],
  },
];
---

<Base
  title={article.data.title}
  description={article.data.description}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
>
  <nav aria-label="パンくずリスト" class="mb-4 text-xs text-zinc-500 dark:text-zinc-400">
    <a href="/" class="hover:underline">ホーム</a>
    {crumb && (
      <>
        <span class="mx-1">/</span>
        <a href={tagPath(crumb)} class="hover:underline">{crumb}</a>
      </>
    )}
  </nav>

  <article>
    <header class="mb-8">
      <time class="text-sm text-zinc-500 dark:text-zinc-400" datetime={published}>
        {article.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Tokyo' })}
      </time>
      <h1 class="mt-2 text-2xl font-bold leading-tight">{article.data.title}</h1>
      <div class="mt-3 flex flex-wrap gap-2">
        {linked.map((tag: string) => (
          <a href={tagPath(tag)} class="rounded-sm bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 hover:text-zinc-900 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:text-zinc-100">
            {tag}
          </a>
        ))}
        {plain.map((tag: string) => (
          <span class="rounded-sm bg-zinc-100 px-2 py-0.5 text-xs text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
            {tag}
          </span>
        ))}
      </div>
    </header>

    {article.data.heroImage && (
      <div class="mb-6 overflow-hidden rounded-lg">
        <img
          src={article.data.heroImage}
          alt={article.data.title}
          class="w-full object-cover"
          loading="eager"
          decoding="async"
          onerror="this.parentElement.style.display='none'"
        />
      </div>
    )}

    <div class="prose prose-zinc dark:prose-invert max-w-none article-body">
      {bodyBefore === null ? <Content /> : <Fragment set:html={bodyBefore} />}
    </div>

    {bodyAfter !== null && (
      <>
        <AdMax
          slotId={AD_SLOTS.mobileInline}
          media={MOBILE_MEDIA}
          width={320}
          height={100}
          label
          class="my-8 md:hidden"
        />
        <div class="prose prose-zinc dark:prose-invert max-w-none article-body">
          <Fragment set:html={bodyAfter} />
        </div>
      </>
    )}
  </article>

  <AdMax
    slotId={AD_SLOTS.mobileRectangle}
    media={MOBILE_MEDIA}
    width={300}
    height={250}
    label
    class="mt-8 md:hidden"
  />

  <RelatedArticles currentSlug={article.id} tags={article.data.tags} />
</Base>
