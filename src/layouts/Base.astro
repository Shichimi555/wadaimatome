---
// src/layouts/Base.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdMax from '../components/AdMax.astro';
import { AD_SLOTS, RAIL_MEDIA } from '../lib/ads';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** 'article' only on article pages; listings are websites. */
  ogType?: 'article' | 'website';
  /** JSON-LD graph nodes for this page. */
  schema?: unknown[];
}

const { title, description, ogImage, ogType = 'website', schema = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// Search Console reported 「検索での見え方」 as three impressions of a product
// snippet and nothing else: the site emitted no structured data at all, so it
// was eligible for no rich result. 94% of its impressions are mobile, where
// the breadcrumb line replaces the raw URL.
const jsonLd =
  schema.length > 0 ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }) : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 話題まとめ</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="話題まとめ" href={new URL('/rss.xml', Astro.site)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="話題まとめ" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@wadaiimatome" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js). is:inline keeps Astro from bundling it, which
         would break the global gtag() the config call depends on. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BTEMRTBR4Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-BTEMRTBR4Y');
    </script>

    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2472916845268460"
      crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100">
    <Header />
    <div class="ad-rails">
      <main class="mx-auto w-full max-w-2xl px-4 py-8">
        <slot />
      </main>
      {AD_SLOTS.railLeft ? (
        <aside class="ad-rail ad-rail--left" aria-label="広告">
          <AdMax slotId={AD_SLOTS.railLeft} media={RAIL_MEDIA} width={160} height={600} class="sticky top-6" />
        </aside>
      ) : (
        <div class="ad-rail ad-rail--left"></div>
      )}
      <aside class="ad-rail ad-rail--right" aria-label="広告">
        <AdMax slotId={AD_SLOTS.railRight} media={RAIL_MEDIA} width={160} height={600} class="sticky top-6" />
      </aside>
    </div>
    <Footer />
  </body>
</html>
