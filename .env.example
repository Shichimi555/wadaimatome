# generate.sh がこのファイル名の `.env` を読み込む（.gitignore 済み）。

# Google AI Studio の API キー。各回の最上位トレンドを検索グラウンディング付きで書く。
# 無料枠は1日20リクエスト/モデル。2.5-flash-lite と 2.5-flash を交互に使うので実質40。
GEMINI_API_KEY=

# Cloudflare Workers AI。残りの記事を Gemma 4 で書く。無料枠は1日10,000 Neuron
# （記事1本あたり約135 Neuron ≒ 74本）。未設定でも動くが、その分 Gemini に寄る。
# トークンは Account > Workers AI > Read だけで足りる。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_READ_TOKEN=

# 公開通知・失敗通知の送り先。空にすると通知は一切出ない。
DISCORD_WEBHOOK_URL=
